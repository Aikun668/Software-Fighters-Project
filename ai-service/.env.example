# LLM Provider（统一 MiniMax Token Plan 直连，OpenAI 兼容 HTTP）
LLM_PROVIDER=openai

# Mock 模式（true=使用 mock LLM 不走真实 API，开发时默认 true）
USE_MOCK_LLM=false

# ── MiniMax Token Plan 直连配置（唯一 LLM 供应商）──
MINIMAX_API_KEY=your_minimax_token_plan_key_here
MINIMAX_BASE_URL=https://api.minimax.cn/v1
# 模型名集中管理：CHAT=路由/初筛/判断/轻量生成，REASONER=重推理/代码/图解（可选，缺省回退 CHAT）
MINIMAX_MODEL_CHAT=MiniMax-M3
MINIMAX_MODEL_REASONER=MiniMax-M3

# 数据库（MySQL）
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/ai_edu

# ChromaDB 配置
CHROMA_PERSIST_PATH=./chroma_data
CHROMA_COLLECTION=ai_intro

# Hugging Face 镜像（国内下载 embedding 模型用）
HF_ENDPOINT=https://hf-mirror.com

# JWT
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
