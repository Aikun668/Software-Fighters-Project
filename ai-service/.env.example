# LLM Provider 选择（spark=讯飞 WebSocket | openai=OpenAI 兼容 HTTP）
LLM_PROVIDER=openai

# Mock 模式（true=使用 mock LLM 不走真实 API，开发时默认 true）
USE_MOCK_LLM=false

# ── OpenAI 兼容 API（LLM_PROVIDER=openai 时生效）──
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_MODEL=deepseek-v4-flash

# ── 讯飞星火 API（LLM_PROVIDER=spark 时生效）──
# SPARK_APP_ID=your_spark_app_id_here
# SPARK_API_KEY=your_spark_api_key_here
# SPARK_API_SECRET=your_spark_api_secret_here

# 数据库（MySQL）
DATABASE_URL=mysql+aiomysql://user:password@localhost:3306/ai_edu

# ChromaDB 配置
CHROMA_PERSIST_PATH=./chroma_data
CHROMA_COLLECTION=ai_intro

# Hugging Face 镜像（国内下载 embedding 模型用）
HF_ENDPOINT=https://hf-mirror.com

# JWT
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
