# 讯飞星火 API 配置
SPARK_API_KEY=your_spark_api_key_here
SPARK_API_SECRET=your_spark_api_secret_here

# ChromaDB 配置
CHROMA_PERSIST_PATH=./chroma_data
CHROMA_COLLECTION=ai_intro

# 数据库（PostgreSQL）
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/ai_edu

# JWT
JWT_SECRET=change_me_in_production
JWT_ALGORITHM=HS256
